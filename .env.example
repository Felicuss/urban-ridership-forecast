# Ключ модели для агента диспетчера. Скопируйте в .env и впишите свой ключ: .env в git не попадает.
# Ollama Cloud (OpenAI-совместимый API): https://ollama.com/settings/keys
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
# быстрые бесплатные модели: gpt-oss:120b, gemma4:31b
LLM_MODEL=gpt-oss:120b

# Вход в интерфейс. Учётные записи через запятую: логин:пароль:имя. По умолчанию dispatcher / chaspik.
# AUTH_USERS=dispatcher:chaspik:Диспетчер,planner:другой-пароль:Плановик
# Ключ подписи сессий, общий для всех реплик (docker compose --scale api=3). Пусто - ключ выводится из AUTH_USERS.
# AUTH_SECRET=
# Под этой учётной записью в API ходят MCP-сервер агента и замер k6; она должна быть в AUTH_USERS.
# MCP_API_USER=dispatcher
# MCP_API_PASSWORD=chaspik
